<%- include('../partials/header', { title }) %><%- include('../partials/nav') %>
    <main class="container narrow">
        <div class="page-heading">
            <div>
                <p class="eyebrow">PROCUREMENT</p>
                <h1>Edit Purchase Order</h1>
            </div>
        </div>

        <section class="panel">
            <form action="/purchase-orders/<%= purchaseOrder.id %>/update" method="POST" class="form-stack">

                <label>Nomor PO *</label>
                <input name="orderNumber" maxlength="50" required value="<%= purchaseOrder.orderNumber %>">

                <div class="form-row">
                    <div>
                        <label>Tanggal pesanan *</label><input type="date" name="orderDate" required
                            value="<%= purchaseOrder.orderDate %>">
                        </div>
                    <div>
                    <label>Total amount (Rp) *</label>
                    <input type="number" name="totalAmount" min="0" step="0.01" required value="<%= purchaseOrder.totalAmount %>"></div>
                </div>

                <label>Supplier *</label>
                <select name="supplierId" required>
                    <% suppliers.forEach(supplier=> { %>
                        <option value="<%= supplier.id %>"
                            <%=purchaseOrder.supplier.id===supplier.id ? 'selected' : '' %>><%= supplier.name %>
                        </option>
                    <% }) %>
                </select>

                <label>Status *</label>
                <select name="status" required>
                    <% statuses.forEach(item=> { %>
                        <option value="<%= item %>" 
                            <%=purchaseOrder.status===item ? 'selected' : '' %>><%= item %>
                        </option>
                    <% }) %>
                </select>

                <div class="actions">
                    <button class="btn btn-primary" type="submit">Simpan Perubahan</button>
                    <a class="btn btn-outline" href="/purchase-orders">Batal</a>
                </div>

            </form>
        </section>
    </main>
<%- include('../partials/footer') %>