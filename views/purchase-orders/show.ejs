<%- include('../partials/header', { title }) %><%- include('../partials/nav') %>
    <main class="container narrow">
        <div class="page-heading">
            <div>
                <p class="eyebrow">DETAIL DATA</p>
                <h1>
                    <%= purchaseOrder.orderNumber %>
                </h1>
                <p class="muted">Purchase order #<%= purchaseOrder.id %>
                </p>
            </div>
            
            <div>
                <a class="btn btn-outline" href="/purchase-orders">← Kembali</a>
            </div>
        </div>

        <section class="panel detail-grid">

            <div>
                <span class="muted">Supplier</span>
                <p>
                    <a href="/suppliers/<%= purchaseOrder.supplier.id %>">
                        <%= purchaseOrder.supplier.name %>
                    </a>
                </p>
            </div>

            <div>
                <span class="muted">Tanggal pesanan</span>
                <p>
                    <%= new Date(purchaseOrder.orderDate).toLocaleDateString('id-ID') %>
                </p>
            </div>

            <div>
                <span class="muted">Total amount</span>
                <p><strong>Rp <%= Number(purchaseOrder.totalAmount).toLocaleString('id-ID') %></strong></p>
            </div>

            <div>
                <span class="muted">Status</span>
                <p>
                    <span class="status status-<%= purchaseOrder.status %>">
                        <%= purchaseOrder.status %>
                    </span>
                </p>
            </div>

        </section>

        <div class="actions">
            <a class="btn btn-primary" 
                href="/purchase-orders/<%= purchaseOrder.id %>/edit">Edit Purchase Order
            </a>
        </div>
    </main>
<%- include('../partials/footer') %>